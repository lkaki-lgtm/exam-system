<div class="space-y-8">
  <div class="flex justify-between items-center">
    <h1 class="text-4xl font-bold text-gray-800">📚 Question Bank</h1>
    <a href="/admin/dashboard" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition">
      ← Back to Dashboard
    </a>
  </div>
  
  <!-- Add Question Form -->
  <div class="bg-white rounded-xl shadow-lg p-6">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">➕ Add New Question</h2>
    
    <form action="/admin/questions/add" method="post" class="space-y-6">
      <!-- Question Text -->
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Question Text</label>
        <input type="text" name="text" required
               class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition"
               placeholder="e.g., What is the capital of France?">
      </div>
      
      <!-- Options Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Option A</label>
          <input type="text" name="opt1" required
                 class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition"
                 placeholder="Enter option A">
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Option B</label>
          <input type="text" name="opt2" required
                 class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition"
                 placeholder="Enter option B">
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Option C</label>
          <input type="text" name="opt3" required
                 class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition"
                 placeholder="Enter option C">
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Option D</label>
          <input type="text" name="opt4" required
                 class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition"
                 placeholder="Enter option D">
        </div>
      </div>

      <!-- NEW: Difficulty and Topic Fields -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Difficulty Level</label>
          <select name="difficulty" required class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition">
            <option value="easy">Easy</option>
            <option value="medium" selected>Medium</option>
            <option value="hard">Hard</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Topic/Category</label>
          <input type="text" name="topic" value="general" required
                 class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition"
                 placeholder="e.g., Science, History, Math">
        </div>
      </div>
      
      <!-- Correct Answer -->
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Correct Answer</label>
        <input type="text" name="correct" required
               class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition"
               placeholder="Must match one of the options exactly">
        <p class="text-xs text-gray-500 mt-1">Enter the exact text of the correct option</p>
      </div>
      
      <div class="flex justify-end">
        <button type="submit" 
                class="bg-green-500 text-white px-8 py-3 rounded-lg font-semibold hover:bg-green-600 transition">
          Add Question
        </button>
      </div>
    </form>
  </div>
  
  <!-- Questions List with Enhanced Columns -->
  <div class="bg-white rounded-xl shadow-lg overflow-hidden">
    <div class="bg-gray-50 px-6 py-4 border-b">
      <h2 class="text-xl font-bold text-gray-800">Current Questions</h2>
    </div>
    
    <% if @questions.empty? %>
      <div class="text-center py-12">
        <p class="text-gray-500">No questions yet. Add your first question above!</p>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-100">
            <tr>
              <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">#</th>
              <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">Question</th>
              <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">Options</th>
              <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">Correct</th>
              <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">Difficulty</th>
              <th class="px-4 py-3 text-left text-sm font-semibold text-gray-600">Topic</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @questions.each_with_index do |q, i| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 text-sm"><%= i + 1 %></td>
                <td class="px-4 py-3 text-sm"><%= q["text"] %></td>
                <td class="px-4 py-3 text-sm">
                  <%= q["options"].join(" • ") %>
                </td>
                <td class="px-4 py-3 text-sm font-bold text-green-600"><%= q["correct"] %></td>
                <td class="px-4 py-3 text-sm">
                  <span class="px-2 py-1 rounded-full text-xs font-semibold
                    <%= q["difficulty"] == 'easy' ? 'bg-green-100 text-green-800' : 
                       (q["difficulty"] == 'medium' ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800') %>">
                    <%= q["difficulty"]&.capitalize || "Medium" %>
                  </span>
                </td>
                <td class="px-4 py-3 text-sm text-gray-600"><%= q["topic"] || "General" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>