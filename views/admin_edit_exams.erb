<div class="space-y-8">
  <div class="flex justify-between items-center">
    <h1 class="text-4xl font-bold text-gray-800">✏️ Edit Scheduled Exams</h1>
    <a href="/admin/dashboard" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition">
      ← Back to Dashboard
    </a>
  </div>

  <% if @schedules.nil? || @schedules.empty? %>
    <div class="bg-white rounded-xl shadow-lg p-12 text-center">
      <div class="text-7xl mb-4">📭</div>
      <h3 class="text-2xl font-bold text-gray-800 mb-2">No Scheduled Exams</h3>
      <p class="text-gray-600 mb-6">Schedule an exam first to edit it.</p>
      <a href="/admin/create-exam" class="bg-green-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-600 transition">
        Schedule Exam
      </a>
    </div>
  <% else %>
    <div class="grid gap-6">
      <% @schedules.each do |schedule| %>
        <div class="bg-white rounded-xl shadow-lg overflow-hidden border-2 border-gray-200 hover:border-blue-500 transition">
          <div class="bg-blue-50 px-5 py-4 border-b flex justify-between items-center">
            <div>
              <p class="text-sm text-blue-600 font-semibold">Exam ID: <%= schedule["id"] || "N/A" %></p>
              <h3 class="text-2xl font-bold text-gray-800 mt-1"><%= schedule["title"] || "Untitled Exam" %></h3>
            </div>

            <span class="px-3 py-1 rounded-full text-sm font-semibold
              <%= (schedule["status"] || "").downcase == "scheduled" ? "bg-green-100 text-green-700" :
                  (schedule["status"] || "").downcase == "active" ? "bg-yellow-100 text-yellow-700" :
                  "bg-gray-100 text-gray-700" %>">
              <%= (schedule["status"] || "unknown").upcase %>
            </span>
          </div>

          <form action="/admin/exams/update/<%= schedule["id"] %>" method="post" class="p-6 space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Exam Title</label>
                <input type="text" name="title" value="<%= schedule["title"] %>" required
                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-blue-500 transition">
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Duration (minutes)</label>
                <input type="number" name="duration" value="<%= schedule["duration_minutes"] %>" required
                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-blue-500 transition">
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Description</label>
              <textarea name="description" rows="3" required
                        class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-blue-500 transition"><%= schedule["description"] %></textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Date</label>
                <input type="date" name="date" value="<%= schedule["scheduled_date"] %>" required
                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-blue-500 transition">
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Start Time</label>
                <input type="time" name="start_time" value="<%= schedule["start_time"] %>" required
                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-blue-500 transition">
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">End Time</label>
                <input type="time" name="end_time" value="<%= schedule["end_time"] %>" required
                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-blue-500 transition">
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Assign Teacher</label>

              <% current_teacher_id = schedule["assigned_teacher_id"] || schedule["teacher_id"] %>

              <select name="assigned_teacher_id"
                      class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition">
                <option value="">-- No teacher assigned --</option>

                <% (@all_teachers || []).each do |teacher| %>
                  <option value="<%= teacher["id"] %>" <%= "selected" if current_teacher_id.to_s == teacher["id"].to_s %>>
                    <%= teacher["name"] %><% if teacher["email"] && !teacher["email"].to_s.strip.empty? %> (<%= teacher["email"] %>)<% end %>
                  </option>
                <% end %>
              </select>
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Exam Status</label>
              <select name="status" class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-blue-500 transition">
                <option value="scheduled" <%= schedule["status"] == "scheduled" ? "selected" : "" %>>Scheduled</option>
                <option value="active" <%= schedule["status"] == "active" ? "selected" : "" %>>Active</option>
                <option value="completed" <%= schedule["status"] == "completed" ? "selected" : "" %>>Completed</option>
                <option value="cancelled" <%= schedule["status"] == "cancelled" ? "selected" : "" %>>Cancelled</option>
              </select>
            </div>

            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-4">Select Questions</label>
              <div class="space-y-4 max-h-60 overflow-y-auto border-2 border-gray-200 rounded-lg p-4">
                <% (@all_questions || []).each do |q| %>
                  <div class="flex items-start space-x-3 p-2 hover:bg-gray-50 rounded">
                    <%
                      checked = false
                      if schedule["questions"].is_a?(Array)
                        checked = schedule["questions"].any? { |sq| sq.is_a?(Hash) && sq["id"].to_s == q["id"].to_s }
                      elsif schedule["question_pool"].is_a?(Array)
                        checked = schedule["question_pool"].map(&:to_s).include?(q["id"].to_s)
                      end
                    %>
                    <input type="checkbox" name="question_ids[]" value="<%= q["id"] %>"
                           <%= checked ? "checked" : "" %>
                           class="mt-1 w-5 h-5 text-blue-600">
                    <div>
                      <p class="font-medium"><%= q["text"] %></p>
                      <p class="text-sm text-gray-600">
                        <%= (q["options"] || []).join(", ") %> |
                        <span class="<%= q["difficulty"] == 'easy' ? 'text-green-600' : (q["difficulty"] == 'medium' ? 'text-yellow-600' : 'text-red-600') %>">
                          <%= q["difficulty"]&.capitalize || "Medium" %>
                        </span>
                      </p>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>

            <div class="flex justify-end space-x-4 pt-4 border-t">
              <button type="submit"
                      class="bg-blue-500 text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-600 transition transform hover:scale-105">
                💾 Update Exam
              </button>
              <a href="/admin/edit-exams"
                 class="bg-gray-500 text-white px-8 py-3 rounded-lg font-semibold hover:bg-gray-600 transition">
                Cancel
              </a>
            </div>
          </form>
        </div>
      <% end %>
    </div>
  <% end %>
</div>