<div class="max-w-4xl mx-auto">
  <!-- Header -->
  <div class="bg-gradient-to-r from-purple-500 to-indigo-600 rounded-2xl shadow-xl p-8 text-white mb-8">
    <h1 class="text-4xl font-bold mb-2">🔧 System Health Dashboard</h1>
    <p class="text-purple-100">Real-time status of your examination system</p>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-white rounded-xl shadow-lg p-6">
      <div class="text-gray-500 text-sm">Server Status</div>
      <div class="flex items-center mt-2">
        <span class="w-3 h-3 bg-green-500 rounded-full animate-pulse mr-2"></span>
        <span class="text-2xl font-bold text-gray-800">Online</span>
      </div>
      <div class="text-sm text-gray-500 mt-2">Current time: <%= Time.now.strftime("%H:%M:%S") %></div>
    </div>

    <div class="bg-white rounded-xl shadow-lg p-6">
      <div class="text-gray-500 text-sm">Ruby Version</div>
      <div class="text-2xl font-bold text-gray-800 mt-2"><%= RUBY_VERSION %></div>
      <div class="text-sm text-gray-500">Sinatra Framework</div>
    </div>

    <div class="bg-white rounded-xl shadow-lg p-6">
      <div class="text-gray-500 text-sm">Server Time</div>
      <div class="text-2xl font-bold text-gray-800 mt-2"><%= Time.now.strftime("%H:%M") %></div>
      <div class="text-sm text-gray-500"><%= Time.now.strftime("%B %d, %Y") %></div>
    </div>
  </div>

  <!-- Database Stats -->
  <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
    <h2 class="text-2xl font-bold text-gray-800 mb-4">📊 Database Statistics</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="text-center p-4 bg-blue-50 rounded-lg">
        <div class="text-3xl font-bold text-blue-600"><%= @stats[:users] %></div>
        <div class="text-sm text-gray-600">Total Users</div>
      </div>
      <div class="text-center p-4 bg-green-50 rounded-lg">
        <div class="text-3xl font-bold text-green-600"><%= @stats[:questions] %></div>
        <div class="text-sm text-gray-600">Questions</div>
      </div>
      <div class="text-center p-4 bg-purple-50 rounded-lg">
        <div class="text-3xl font-bold text-purple-600"><%= @stats[:exams] %></div>
        <div class="text-sm text-gray-600">Scheduled Exams</div>
      </div>
      <div class="text-center p-4 bg-yellow-50 rounded-lg">
        <div class="text-3xl font-bold text-yellow-600"><%= @stats[:attempts] %></div>
        <div class="text-sm text-gray-600">Exam Attempts</div>
      </div>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="bg-white rounded-xl shadow-lg p-6">
    <h2 class="text-2xl font-bold text-gray-800 mb-4">🔗 Quick Navigation</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <a href="/" class="text-center p-3 bg-gray-100 rounded-lg hover:bg-gray-200 transition">🏠 Home</a>
      <a href="/login" class="text-center p-3 bg-gray-100 rounded-lg hover:bg-gray-200 transition">🔐 Login</a>
      <a href="/register" class="text-center p-3 bg-gray-100 rounded-lg hover:bg-gray-200 transition">📝 Register</a>
      <a href="/admin/dashboard" class="text-center p-3 bg-gray-100 rounded-lg hover:bg-gray-200 transition">⚙️ Admin</a>
    </div>
  </div>

  <!-- Debug Info (Collapsible) -->
  <details class="mt-8 bg-gray-800 rounded-xl p-4">
    <summary class="text-white font-semibold cursor-pointer">🔧 Technical Details</summary>
    <pre class="mt-4 text-xs text-green-400 overflow-auto">
Session: <%= session.inspect %>
Time Zone: <%= Time.now.zone %>
Request Time: <%= Time.now %>
    </pre>
  </details>
</div>