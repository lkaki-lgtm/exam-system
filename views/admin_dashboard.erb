<div class="space-y-8">
  <h1 class="text-4xl font-bold text-gray-800">👑 Admin Dashboard</h1>
  
  <!-- Stats -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <div class="bg-white rounded-xl shadow-md p-6">
      <div class="text-3xl font-bold text-gray-800"><%= @students.count %></div>
      <div class="text-gray-600">Registered Students</div>
    </div>
    <div class="bg-white rounded-xl shadow-md p-6">
      <div class="text-3xl font-bold text-gray-800"><%= @schedules.count %></div>
      <div class="text-gray-600">Scheduled Exams</div>
    </div>
    <div class="bg-white rounded-xl shadow-md p-6">
      <div class="text-3xl font-bold text-gray-800"><%= @attempts.count %></div>
      <div class="text-gray-600">Completed Exams</div>
    </div>
    <div class="bg-white rounded-xl shadow-md p-6">
      <div class="text-3xl font-bold text-gray-800">
        <%= @schedules.select { |s| s["status"] == "scheduled" }.count %>
      </div>
      <div class="text-gray-600">Upcoming</div>
    </div>
  </div>
  
  <!-- Quick Actions -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <a href="/admin/create-exam" class="bg-green-500 text-white rounded-xl p-6 hover:bg-green-600 transition">
      <div class="text-4xl mb-2">📝</div>
      <h3 class="text-xl font-bold">Schedule New Exam</h3>
      <p class="text-green-100">Create and schedule an exam</p>
    </a>
    
    <a href="/admin/students" class="bg-blue-500 text-white rounded-xl p-6 hover:bg-blue-600 transition">
      <div class="text-4xl mb-2">👥</div>
      <h3 class="text-xl font-bold">Manage Students</h3>
      <p class="text-blue-100">Add or view students</p>
    </a>
    
    <a href="/admin/results" class="bg-purple-500 text-white rounded-xl p-6 hover:bg-purple-600 transition">
      <div class="text-4xl mb-2">📊</div>
      <h3 class="text-xl font-bold">View Results</h3>
      <p class="text-purple-100">See all exam results</p>
    </a>
  </div>
  
  <!-- Recent Schedules -->
  <div class="bg-white rounded-xl shadow-md p-6">
    <h2 class="text-2xl font-bold text-gray-800 mb-4">Recent Scheduled Exams</h2>
    
    <% if @schedules.empty? %>
      <p class="text-gray-600">No exams scheduled yet.</p>
    <% else %>
      <div class="space-y-4">
        <% @schedules.last(5).each do |s| %>
          <div class="border rounded-lg p-4">
            <div class="flex justify-between items-center">
              <div>
                <h3 class="font-bold text-lg"><%= s["title"] %></h3>
                <p class="text-gray-600"><%= s["scheduled_date"] %> · <%= s["start_time"] %> - <%= s["end_time"] %></p>
                <p class="text-sm text-gray-500"><%= s["questions"].count %> questions · <%= s["duration_minutes"] %> minutes</p>
              </div>
              <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm">
                <%= s["status"] %>
              </span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>