<div class="space-y-8">
  <h1 class="text-4xl font-bold text-gray-800">👨‍💼 Admin Dashboard</h1>

  <!-- Stats Overview -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <div class="bg-white rounded-xl shadow-md p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-500 text-sm">Total Questions</p>
          <p class="text-3xl font-bold text-gray-800"><%= @questions.count %></p>
        </div>
        <div class="bg-green-100 rounded-full p-3">
          <span class="text-2xl">📚</span>
        </div>
      </div>
    </div>
    
    <div class="bg-white rounded-xl shadow-md p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-500 text-sm">Active Exams</p>
          <p class="text-3xl font-bold text-gray-800">1</p>
        </div>
        <div class="bg-blue-100 rounded-full p-3">
          <span class="text-2xl">📝</span>
        </div>
      </div>
    </div>
    
    <div class="bg-white rounded-xl shadow-md p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-500 text-sm">Total Students</p>
          <p class="text-3xl font-bold text-gray-800">-</p>
        </div>
        <div class="bg-purple-100 rounded-full p-3">
          <span class="text-2xl">👥</span>
        </div>
      </div>
    </div>
    
    <div class="bg-white rounded-xl shadow-md p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-500 text-sm">Completion Rate</p>
          <p class="text-3xl font-bold text-gray-800">-</p>
        </div>
        <div class="bg-yellow-100 rounded-full p-3">
          <span class="text-2xl">📊</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Add Question Form -->
  <div class="bg-white rounded-xl shadow-lg overflow-hidden">
    <div class="bg-gradient-to-r from-green-500 to-green-600 px-8 py-6">
      <h2 class="text-2xl font-bold text-white flex items-center">
        <span class="mr-2">➕</span> Add New Question
      </h2>
    </div>
    
    <form action="/admin/add" method="post" class="p-8">
      <div class="space-y-6">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Question Text</label>
          <input type="text" name="text" required
                 class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 
                        focus:ring focus:ring-green-200 transition" 
                 placeholder="e.g., What is the capital of France?">
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Option A</label>
            <input type="text" name="opt1" required
                   class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 
                          focus:ring focus:ring-green-200 transition"
                   placeholder="Enter option A">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Option B</label>
            <input type="text" name="opt2" required
                   class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 
                          focus:ring focus:ring-green-200 transition"
                   placeholder="Enter option B">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Option C</label>
            <input type="text" name="opt3" required
                   class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 
                          focus:ring focus:ring-green-200 transition"
                   placeholder="Enter option C">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Option D</label>
            <input type="text" name="opt4" required
                   class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 
                          focus:ring focus:ring-green-200 transition"
                   placeholder="Enter option D">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Correct Answer</label>
            <input type="text" name="correct" required
                   class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 
                          focus:ring focus:ring-green-200 transition"
                   placeholder="Must match one of the options exactly">
          </div>
        </div>
        
        <div class="flex justify-end">
          <button type="submit" 
                  class="px-8 py-3 bg-green-500 text-white rounded-lg font-semibold 
                         hover:bg-green-600 transition transform hover:scale-105 
                         focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2">
            Add Question
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- Questions List -->
  <div class="bg-white rounded-xl shadow-lg overflow-hidden">
    <div class="bg-gray-50 px-8 py-6 border-b border-gray-200">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold text-gray-800">📚 Question Bank</h2>
        <span class="bg-green-100 text-green-800 px-4 py-2 rounded-full text-sm font-semibold">
          <%= @questions.count %> Total Questions
        </span>
      </div>
    </div>
    
    <% if @questions.empty? %>
      <div class="text-center py-16">
        <div class="text-7xl mb-4">📭</div>
        <h3 class="text-2xl font-bold text-gray-800 mb-2">No Questions Yet</h3>
        <p class="text-gray-600 mb-6">Use the form above to add your first question.</p>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-100">
            <tr>
              <th class="px-8 py-4 text-left text-sm font-semibold text-gray-600">#</th>
              <th class="px-8 py-4 text-left text-sm font-semibold text-gray-600">Question</th>
              <th class="px-8 py-4 text-left text-sm font-semibold text-gray-600">Options</th>
              <th class="px-8 py-4 text-left text-sm font-semibold text-gray-600">Correct Answer</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @questions.each_with_index do |q, i| %>
              <tr class="hover:bg-gray-50 transition">
                <td class="px-8 py-4 text-sm font-medium text-gray-900"><%= i + 1 %></td>
                <td class="px-8 py-4 text-sm text-gray-800"><%= q["text"] %></td>
                <td class="px-8 py-4 text-sm text-gray-600">
                  <div class="space-y-1">
                    <% q["options"].each do |opt| %>
                      <div class="flex items-center">
                        <span class="w-2 h-2 bg-gray-400 rounded-full mr-2"></span>
                        <%= opt %>
                      </div>
                    <% end %>
                  </div>
                </td>
                <td class="px-8 py-4">
                  <span class="px-4 py-2 bg-green-100 text-green-800 rounded-lg text-sm font-semibold">
                    <%= q["correct"] %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>