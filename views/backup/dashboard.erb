<div class="space-y-8">
  <!-- Welcome Header -->
  <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-2xl shadow-xl p-8 text-white">
    <h1 class="text-4xl font-bold mb-2">Welcome, <%= @name %>! 👋</h1>
    <p class="text-green-100 text-lg">Ready to test your knowledge?</p>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-green-500 hover:shadow-lg transition">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-500 text-sm">Available Exams</p>
          <p class="text-3xl font-bold text-gray-800">1</p>
        </div>
        <div class="bg-green-100 rounded-full p-3">
          <span class="text-2xl">📝</span>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-blue-500 hover:shadow-lg transition">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-500 text-sm">Completed Exams</p>
          <p class="text-3xl font-bold text-gray-800"><%= @previous_results.count %></p>
        </div>
        <div class="bg-blue-100 rounded-full p-3">
          <span class="text-2xl">✅</span>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-md p-6 border-l-4 border-purple-500 hover:shadow-lg transition">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-500 text-sm">Average Score</p>
          <p class="text-3xl font-bold text-gray-800">
            <% if @previous_results.any? %>
              <%= (@previous_results.sum { |r| r["percentage"] } / @previous_results.size).round %>%
            <% else %>
              -
            <% end %>
          </p>
        </div>
        <div class="bg-purple-100 rounded-full p-3">
          <span class="text-2xl">📊</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <a href="/exams" class="bg-white rounded-xl shadow-md p-8 hover:shadow-xl transition group">
      <div class="text-5xl mb-4 group-hover:scale-110 transition-transform">📝</div>
      <h3 class="text-2xl font-bold text-gray-800 mb-2">Take an Exam</h3>
      <p class="text-gray-600">Start a new exam and test your knowledge with timed questions</p>
      <div class="mt-4 text-green-500 font-semibold group-hover:translate-x-2 transition">
        Start Now →
      </div>
    </a>
    
    <a href="/admin" class="bg-white rounded-xl shadow-md p-8 hover:shadow-xl transition group">
      <div class="text-5xl mb-4 group-hover:scale-110 transition-transform">⚙️</div>
      <h3 class="text-2xl font-bold text-gray-800 mb-2">Admin Panel</h3>
      <p class="text-gray-600">Manage questions, add new content, and view all results</p>
      <div class="mt-4 text-green-500 font-semibold group-hover:translate-x-2 transition">
        Manage →
      </div>
    </a>
  </div>

  <!-- Recent Results -->
  <% if @previous_results.any? %>
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
      <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
        <h3 class="text-xl font-bold text-gray-800">📊 Recent Results</h3>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-100">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Date</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Score</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Percentage</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @previous_results.last(5).each do |r| %>
              <tr class="hover:bg-gray-50 transition">
                <td class="px-6 py-4 text-sm text-gray-800"><%= r["date"][0..10] %></td>
                <td class="px-6 py-4 text-sm text-gray-800"><%= r["score"] %>/<%= r["total"] %></td>
                <td class="px-6 py-4 text-sm text-gray-800"><%= r["percentage"] %>%</td>
                <td class="px-6 py-4">
                  <% if r["percentage"] >= 70 %>
                    <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-xs font-semibold">Excellent</span>
                  <% elsif r["percentage"] >= 40 %>
                    <span class="px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-xs font-semibold">Good</span>
                  <% else %>
                    <span class="px-3 py-1 bg-red-100 text-red-800 rounded-full text-xs font-semibold">Needs Practice</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="bg-white rounded-xl shadow-md p-12 text-center">
      <div class="text-7xl mb-4">📭</div>
      <h3 class="text-2xl font-bold text-gray-800 mb-2">No Exams Taken Yet</h3>
      <p class="text-gray-600 mb-6">Start your first exam to see your results here!</p>
      <a href="/exams" class="inline-block bg-green-500 text-white px-8 py-3 rounded-lg font-semibold hover:bg-green-600 transition">
        Take Your First Exam
      </a>
    </div>
  <% end %>
</div>