<div class="max-w-4xl mx-auto">
  <h1 class="text-4xl font-bold text-gray-800 mb-8">📝 Schedule New Exam</h1>
  
  <form action="/admin/create-exam" method="post" class="bg-white rounded-xl shadow-lg p-8">
    <div class="space-y-6">
      <!-- Basic Info -->
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Exam Title</label>
        <input type="text" name="title" required
               class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition">
      </div>
      
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">Description</label>
        <textarea name="description" rows="3" required
                  class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition"></textarea>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Duration (minutes)</label>
          <input type="number" name="duration" value="30" required
                 class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition">
        </div>
        
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Date</label>
          <input type="date" name="date" required
                 class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition">
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Start Time</label>
          <input type="time" name="start_time" required
                 class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition">
        </div>
        
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">End Time</label>
          <input type="time" name="end_time" required
                 class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition">
        </div>
      </div>
      
      <!-- Question Selection -->
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-4">Select Questions</label>
        
        <% if @questions.empty? %>
          <p class="text-gray-600">No questions available. <a href="/admin" class="text-green-500">Add some first!</a></p>
        <% else %>
          <div class="space-y-4 max-h-96 overflow-y-auto border rounded-lg p-4">
            <% @questions.each_with_index do |q, i| %>
              <div class="flex items-start space-x-3">
                <input type="checkbox" name="question_ids[]" value="<%= q["id"] %>" 
                       class="mt-1 w-5 h-5 text-green-600">
                <div>
                  <p class="font-medium">Question <%= i + 1 %>: <%= q["text"] %></p>
                  <p class="text-sm text-gray-600">Options: <%= q["options"].join(", ") %></p>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
      
      <div class="flex justify-end">
        <button type="submit" 
                class="bg-green-500 text-white px-8 py-3 rounded-lg font-semibold hover:bg-green-600 transition">
          Schedule Exam
        </button>
      </div>
    </div>
  </form>
</div>