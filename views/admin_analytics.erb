<div class="space-y-8">
  <div class="flex justify-between items-center">
    <h1 class="text-4xl font-bold text-gray-800">📈 System Analytics</h1>
    <a href="/admin/dashboard" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition">
      ← Back to Dashboard
    </a>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl shadow-lg p-6 text-white">
      <p class="text-blue-100 text-sm">Total Users</p>
      <p class="text-3xl font-bold mt-2"><%= @analytics["total_users"] %></p>
    </div>
    <div class="bg-gradient-to-br from-green-500 to-green-600 rounded-xl shadow-lg p-6 text-white">
      <p class="text-green-100 text-sm">Total Exams</p>
      <p class="text-3xl font-bold mt-2"><%= @analytics["total_exams"] %></p>
    </div>
    <div class="bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl shadow-lg p-6 text-white">
      <p class="text-purple-100 text-sm">Total Attempts</p>
      <p class="text-3xl font-bold mt-2"><%= @analytics["total_attempts"] %></p>
    </div>
    <div class="bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-xl shadow-lg p-6 text-white">
      <p class="text-yellow-100 text-sm">Avg. Score</p>
      <p class="text-3xl font-bold mt-2"><%= @analytics["average_score"] %>%</p>
    </div>
  </div>

  <!-- Charts Row -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- Question Difficulty Chart -->
    <div class="bg-white rounded-xl shadow-lg p-6">
      <h2 class="text-2xl font-bold text-gray-800 mb-4">📊 Question Difficulty Distribution</h2>
      <canvas id="difficultyChart"></canvas>
    </div>

    <!-- Exam Performance Chart -->
    <div class="bg-white rounded-xl shadow-lg p-6">
      <h2 class="text-2xl font-bold text-gray-800 mb-4">📈 Exam Performance Trends</h2>
      <canvas id="performanceChart"></canvas>
    </div>
  </div>

  <!-- Detailed Stats -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-white rounded-xl shadow-lg p-6">
      <h3 class="text-lg font-bold text-gray-800 mb-4">👥 User Statistics</h3>
      <div class="space-y-3">
        <div class="flex justify-between">
          <span class="text-gray-600">Admins:</span>
          <span class="font-bold"><%= @analytics["admin_count"] %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Teachers:</span>
          <span class="font-bold"><%= @analytics["teacher_count"] %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Students:</span>
          <span class="font-bold"><%= @analytics["student_count"] %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Active Students:</span>
          <span class="font-bold"><%= @analytics["active_students"] %></span>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg p-6">
      <h3 class="text-lg font-bold text-gray-800 mb-4">📝 Question Bank</h3>
      <div class="space-y-3">
        <div class="flex justify-between">
          <span class="text-gray-600">Total Questions:</span>
          <span class="font-bold"><%= @analytics["total_questions"] %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Easy:</span>
          <span class="font-bold"><%= @analytics["easy_questions"] %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Medium:</span>
          <span class="font-bold"><%= @analytics["medium_questions"] %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Hard:</span>
          <span class="font-bold"><%= @analytics["hard_questions"] %></span>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg p-6">
      <h3 class="text-lg font-bold text-gray-800 mb-4">📊 Exam Statistics</h3>
      <div class="space-y-3">
        <div class="flex justify-between">
          <span class="text-gray-600">Completed:</span>
          <span class="font-bold"><%= @analytics["completed_exams"] %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">In Progress:</span>
          <span class="font-bold"><%= @analytics["in_progress"] %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Scheduled:</span>
          <span class="font-bold"><%= @analytics["scheduled"] %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Malpractice Cases:</span>
          <span class="font-bold"><%= @analytics["malpractice_cases"] %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Activity -->
  <div class="bg-white rounded-xl shadow-lg p-6">
    <h2 class="text-2xl font-bold text-gray-800 mb-4">🕒 Recent Activity</h2>
    <div class="space-y-3">
      <% @analytics["recent_activity"].each do |activity| %>
        <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg">
          <span class="text-2xl"><%= activity["icon"] %></span>
          <div class="flex-1">
            <p class="text-sm text-gray-800"><%= activity["message"] %></p>
            <p class="text-xs text-gray-500"><%= activity["time"] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // Difficulty Chart
  const difficultyCtx = document.getElementById('difficultyChart').getContext('2d');
  new Chart(difficultyCtx, {
    type: 'doughnut',
    data: {
      labels: ['Easy', 'Medium', 'Hard'],
      datasets: [{
        data: [<%= @analytics["easy_questions"] %>, <%= @analytics["medium_questions"] %>, <%= @analytics["hard_questions"] %>],
        backgroundColor: ['#10b981', '#f59e0b', '#ef4444']
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          position: 'bottom'
        }
      }
    }
  });

  // Performance Chart
  const perfCtx = document.getElementById('performanceChart').getContext('2d');
  new Chart(perfCtx, {
    type: 'line',
    data: {
      labels: <%= @analytics["performance_labels"].to_json %>,
      datasets: [{
        label: 'Average Score %',
        data: <%= @analytics["performance_data"].to_json %>,
        borderColor: '#8b5cf6',
        backgroundColor: 'rgba(139, 92, 246, 0.1)',
        tension: 0.4
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          display: false
        }
      }
    }
  });
</script>