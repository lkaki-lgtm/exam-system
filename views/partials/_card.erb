<%# views/partials/_card.erb - Reusable card component %>
<% 
  padding = local_assigns[:padding] || "p-6"
  hover = local_assigns[:hover] != false ? "hover-card" : ""
  gradient = local_assigns[:gradient] || ""
%>

<div class="bg-white rounded-xl shadow-lg <%= padding %> <%= hover %> <%= gradient %>">
  <% if local_assigns[:title] %>
    <h3 class="text-xl font-bold text-gray-800 mb-4"><%= title %></h3>
  <% end %>
  
  <%= yield %>
</div>