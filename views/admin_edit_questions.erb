<div class="space-y-8">
  <div class="flex justify-between items-center">
    <h1 class="text-4xl font-bold text-gray-800">✏️ Edit Questions</h1>
    <a href="/admin/dashboard" class="bg-gray-500 text-white px-4 py-2 rounded-lg hover:bg-gray-600 transition">
      ← Back to Dashboard
    </a>
  </div>

  <% if @questions.empty? %>
    <div class="bg-white rounded-xl shadow-lg p-12 text-center">
      <div class="text-7xl mb-4">📭</div>
      <h3 class="text-2xl font-bold text-gray-800 mb-2">No Questions Found</h3>
      <p class="text-gray-600 mb-6">Add some questions first to edit them.</p>
      <a href="/admin/questions" class="bg-green-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-600 transition">
        Add Questions
      </a>
    </div>
  <% else %>
    <div class="grid gap-6">
      <% @questions.each_with_index do |q, index| %>
        <div class="bg-white rounded-xl shadow-lg overflow-hidden border-2 border-gray-200 hover:border-green-500 transition">
          <!-- Question Header -->
          <div class="bg-gradient-to-r from-gray-50 to-gray-100 px-6 py-4 border-b flex justify-between items-center">
            <div>
              <span class="text-sm text-gray-500">Question #<%= index + 1 %></span>
              <h3 class="font-bold text-gray-800 mt-1"><%= q["text"] %></h3>
            </div>
            <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm">
              ID: <%= q["id"][-8..-1] %>
            </span>
          </div>

          <!-- Edit Form -->
          <form action="/admin/questions/update/<%= q["id"] %>" method="post" class="p-6 space-y-6">
            <!-- Question Text -->
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Question Text</label>
              <input type="text" name="text" value="<%= q["text"] %>" required
                     class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition">
            </div>

            <!-- Options Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Option A</label>
                <input type="text" name="opt1" value="<%= q["options"][0] %>" required
                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition">
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Option B</label>
                <input type="text" name="opt2" value="<%= q["options"][1] %>" required
                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition">
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Option C</label>
                <input type="text" name="opt3" value="<%= q["options"][2] %>" required
                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition">
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Option D</label>
                <input type="text" name="opt4" value="<%= q["options"][3] %>" required
                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition">
              </div>
            </div>

            <!-- NEW: Difficulty and Topic Fields -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Difficulty Level</label>
                <select name="difficulty" required class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition">
                  <option value="easy" <%= q["difficulty"] == "easy" ? "selected" : "" %>>Easy</option>
                  <option value="medium" <%= q["difficulty"] == "medium" ? "selected" : "" %>>Medium</option>
                  <option value="hard" <%= q["difficulty"] == "hard" ? "selected" : "" %>>Hard</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Topic/Category</label>
                <input type="text" name="topic" value="<%= q["topic"] || "general" %>" required
                       class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition"
                       placeholder="e.g., Science, History, Math">
              </div>
            </div>

            <!-- Correct Answer -->
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Correct Answer</label>
              <input type="text" name="correct" value="<%= q["correct"] %>" required
                     class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-green-500 transition">
              <p class="text-xs text-gray-500 mt-1">Current correct answer: <span class="font-bold text-green-600"><%= q["correct"] %></span></p>
            </div>

            <!-- Action Buttons -->
            <div class="flex justify-end space-x-4 pt-4 border-t">
              <button type="submit" 
                      class="bg-green-500 text-white px-8 py-3 rounded-lg font-semibold hover:bg-green-600 transition">
                💾 Save Changes
              </button>
              <a href="/admin/edit-questions" 
                 class="bg-gray-500 text-white px-8 py-3 rounded-lg font-semibold hover:bg-gray-600 transition">
                Cancel
              </a>
            </div>
          </form>
        </div>
      <% end %>
    </div>
  <% end %>
</div>